// Tempo — Story-tagging runs (design ERD)
// Cloud: https://dbdiagram.io/d/6ae28fe9ed134e407e37a621
// Title: Story-tagging runs
// Status: Locked (B2a) · Last updated: 2 Nov 2026
//
// Sibling to tempo.dbml (product Database library) and summarization-runs.dbml.
// Intent: per-attempt LLM lineage for stage=story-tagging.
// Not live Supabase until migrated. DBML is the design map.
//
// Grain: one row per LLM **attempt**. trigger_id groups ≤2 attempts for one invoke
// (Haiku primary, optional Sonnet escalate — same trigger_id, different model_id).
// Skip / no-model paths (empty aperture ST-15; IR-14 no text change; IR-15 duplicate)
// do NOT insert rows. Failed LLM attempts still get rows (fail-open pool).
//
// Forward compat:
//   stage — default 'story-tagging'; path toward shared ai_runs later
//
// Body / publisher text: never a column (note only). No output_json — story_* joins
// are SoT. No eval_scores — offline gold. No accepted_at (extraction-only).
// No fallback_used / attempt_index columns.
//
// Product / eng SoTs: contracts/story-tagging.md · pipelines/story-tagging.md ·
// prompts/story-tagging.md · evals/story-tagging.md

Project story_tagging_runs {
  database_type: 'PostgreSQL'
  Note: 'Per-attempt LLM lineage for stage=story-tagging. Sibling to product Database library. Never store publisher body. Locked B2a.'
}

Enum story_tagging_trigger_kind {
  clock
  warm
  x_edit
}

Enum story_tagging_run_status {
  succeeded
  failed
}

Enum story_tagging_error_kind {
  timeout
  provider_http_error
  provider_error
  config_error
  schema_error
  empty_response
  unknown
}

TableGroup "Story-tagging runs" [color: #E8D5C4, note: 'One row per LLM attempt'] {
  story_tagging_runs
}

TableGroup "Product stubs" [color: #E8E6E1, note: 'Canonical shapes: tempo.dbml → Supabase'] {
  stories
}

Table stories {
  story_id uuid [pk]

  Note: 'STUB for FK visibility. Full table owned by tempo.dbml / Supabase (press or X story).'
}

Table story_tagging_runs {
  run_id uuid [pk]
  trigger_id uuid [not null, note: 'Shared by attempts for one invoke; primary + one retry (≤2)']
  trigger_kind story_tagging_trigger_kind [not null, note: 'clock | warm = new admit (IR-08); x_edit = IR-14 text change']
  stage varchar(64) [not null, default: 'story-tagging', note: 'Forward compat toward multi-stage ai_runs']
  story_id uuid [not null, ref: > stories.story_id, note: 'Press or X story being tagged']
  status story_tagging_run_status [not null]
  model_provider varchar(64) [not null, note: 'e.g. anthropic']
  model_id varchar(128) [not null, note: 'Router SKU at write time — default anthropic:claude-haiku-5-5; escalate anthropic:claude-sonnet-5-5 (prompts/story-tagging.md)']
  prompt_version varchar(64) [not null, note: 'e.g. story-tagging-v1']
  input_hash varchar(64) [not null, note: 'SHA-256 hex of UTF-8 text_payload + "\\n---\\n" + catalog_payload as sent to the model; excludes system prompt; never retain body bytes']
  prompt_tokens int [null]
  output_tokens int [null]
  estimated_cost_usd decimal [null, note: 'tokens × 07-ops/model-pricing.json at write time; null if model_id missing from catalog']
  error_kind story_tagging_error_kind [null, note: 'Set when status=failed — closed labels only']
  started_at timestamptz [not null]
  finished_at timestamptz [null, note: 'Null only while in flight']

  indexes {
    (trigger_id)
    (story_id, started_at)
    (prompt_version, started_at)
  }

  Note: 'No output_json (story_topics|keywords|geographies replace-set is SoT). No fallback_used / attempt_index (same trigger_id + different model_id). No eval_scores. Never store publisher body. Skip/no-model paths do not insert rows. Fail-open pool still records failed LLM attempts.'
}
