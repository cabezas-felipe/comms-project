// Tempo — Summarization runs (design ERD)
// Cloud: https://dbdiagram.io/d/6ae28ffced134e407e37a6d0
// Title: Summarization runs
// Status: Locked (B2) · Last updated: 2 Nov 2026 (coherence pass)
//
// Skip / no-model paths do NOT insert rows and do NOT emit summarization_invoke (D-088).
// PostHog invoke is specified on model--summarization--v1.md — not a column here.
//
// Sibling to tempo.dbml (product Database library) and extraction-runs.dbml.
// Intent: per-attempt LLM lineage for stage=summarization.
// Not live Supabase until migrated. DBML is the design map.
//
// Grain: one row per LLM **attempt**. trigger_id groups ≤2 attempts for one invoke
// (Haiku primary, optional Sonnet escalate — same trigger_id, different model_id).
// Skip / no-model paths (X; no body; already has article summary) do NOT insert rows.
//
// Forward compat:
//   stage — default 'summarization'; path toward shared ai_runs later
//
// Body / publisher text: never a column (note only). No output_json — product
// tables are SoT (press_articles.article_summary). No eval_scores — offline gold.
// No accepted_at (extraction-only). No fallback_used / attempt_index columns.
//
// Product / eng SoTs: contracts/summarization.md · pipelines/summarization.md ·
// prompts/summarization.md · evals/summarization.md

Project summarization_runs {
  database_type: 'PostgreSQL'
  Note: 'Per-attempt LLM lineage for stage=summarization. Sibling to product Database library. Never store publisher body. Locked B2.'
}

Enum summarization_trigger_kind {
  clock
  warm
}

Enum summarization_run_status {
  succeeded
  failed
}

Enum summarization_error_kind {
  timeout
  provider_http_error
  provider_error
  config_error
  schema_error
  empty_response
  unknown
}

TableGroup "Summarization runs" [color: #E8D5C4, note: 'One row per LLM attempt'] {
  summarization_runs
}

TableGroup "Product stubs" [color: #E8E6E1, note: 'Canonical shapes: tempo.dbml → Supabase'] {
  stories
}

Table stories {
  story_id uuid [pk]

  Note: 'STUB for FK visibility. Full table owned by tempo.dbml / Supabase (press keep-list via press_articles).'
}

Table summarization_runs {
  run_id uuid [pk]
  trigger_id uuid [not null, note: 'Shared by attempts for one invoke; primary + one retry (≤2)']
  trigger_kind summarization_trigger_kind [not null, note: 'clock | warm — ingestion IR-11 paths']
  stage varchar(64) [not null, default: 'summarization', note: 'Forward compat toward multi-stage ai_runs']
  story_id uuid [not null, ref: > stories.story_id, note: 'Press story being summarized']
  status summarization_run_status [not null]
  model_provider varchar(64) [not null, note: 'e.g. anthropic']
  model_id varchar(128) [not null, note: 'Router SKU at write time — default anthropic:claude-haiku-5-5; escalate anthropic:claude-sonnet-5-5 (prompts/summarization.md)']
  prompt_version varchar(64) [not null, note: 'e.g. summarization-v1']
  input_hash varchar(64) [not null, note: 'SHA-256 hex of UTF-8 title + "\\n\\n" + body as sent to the model; excludes system prompt; never retain body bytes']
  prompt_tokens int [null]
  output_tokens int [null]
  estimated_cost_usd decimal [null, note: 'tokens × 07-ops/model-pricing.json at write time; null if model_id missing from catalog']
  error_kind summarization_error_kind [null, note: 'Set when status=failed — closed labels only']
  started_at timestamptz [not null]
  finished_at timestamptz [null, note: 'Null only while in flight']

  indexes {
    (trigger_id)
    (story_id, started_at)
    (prompt_version, started_at)
  }

  Note: 'No output_json (article_summary on press keep-list is SoT). No fallback_used / attempt_index (same trigger_id + different model_id). No eval_scores. Never store publisher body. Skip/no-model paths do not insert rows.'
}
